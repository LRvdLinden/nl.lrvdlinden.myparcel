  "description": {
    "en": "MyParcel brings supported parcel carriers together in Homey",
    "nl": "MyParcel brengt ondersteunde pakketvervoerders samen in Homey",
    "de": "MyParcel vereint unterstützte Paketdienste in Homey",
    "fr": "MyParcel réunit les transporteurs de colis pris en charge dans Homey",
    "it": "MyParcel riunisce in Homey i corrieri supportati",
    "sv": "MyParcel samlar paketleverantörer som stöds i Homey",
    "no": "MyParcel samler støttede pakketransportører i Homey",
    "es": "MyParcel reúne en Homey los transportistas de paquetería compatibles",
    "da": "MyParcel samler understøttede pakketransportører i Homey",
    "ru": "MyParcel объединяет поддерживаемых перевозчиков посылок в Homey",
    "pl": "MyParcel łączy obsługiwanych przewoźników paczek w Homey",
    "ko": "MyParcel은 지원되는 택배사를 Homey에 통합합니다",
    "ar": "يجمع MyParcel شركات شحن الطرود المدعومة في Homey"
  },
  "widgets": {
    "poststukken": {
      "name": {
        "en": "My Post",
        "nl": "Mijn Post",
        "de": "PostNL Briefsendungen",
        "fr": "Courrier PostNL",
        "it": "Posta PostNL",
        "sv": "PostNL-post",
        "no": "PostNL-post",
        "es": "Correo PostNL",
        "da": "PostNL-post",

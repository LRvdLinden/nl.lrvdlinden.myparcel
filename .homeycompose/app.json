        "ko": "PostNL 우편물",
        "ar": "بريد PostNL"
      },
      "height": 250,
      "api": {
        "getData": {
          "method": "GET",
          "path": "/"
        },
        "sync": {
          "method": "POST",
          "path": "/sync"
        }
      },
      "devices": {
        "type": "app",
        "singular": true,
        "filter": {
          "capabilities": "postnl_mail_count"
        }
      },
      "id": "poststukken",
      "settings": []
    },

  "id": "nl.lrvdlinden.MyParcel",
  "version": "0.3.5",
  "brandColor": "#105945",
  "name": {
    "en": "MyParcel",
    "nl": "MyParcel",
    "de": "MyParcel",
    "fr": "MyParcel",
    "it": "MyParcel",
    "sv": "MyParcel",
    "no": "MyParcel",
    "es": "MyParcel",
